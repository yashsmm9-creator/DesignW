# Copy this file to .env and replace the placeholder values. Never commit .env.

# Twilio Console credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Twilio WhatsApp Sandbox sender (check the exact sender in your Twilio Console)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional email OTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-sender@gmail.com
SMTP_USE_TLS=1
